NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (https://supabase.com) — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Gemini (https://aistudio.google.com/apikey)
# Current vision/text model: gemini-3.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Groq (https://console.groq.com/keys) — fast text fallback + chat
# Current model: openai/gpt-oss-120b
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Google Calendar OAuth (https://console.cloud.google.com/apis/credentials)
# Create an OAuth client (Web). Authorized redirect:
#   {NEXT_PUBLIC_APP_URL}/api/google/callback
# Enable the Google Calendar API on the project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
